# Local development. Copy to .env and adjust.
DATABASE_URL=postgres://bgs:bgs_dev@127.0.0.1:5432/bgs_dev
TEST_DATABASE_URL=postgres://bgs:bgs_dev@127.0.0.1:5432/bgs_test

# Session signing secret. Generate with: openssl rand -hex 32
SESSION_SECRET=change-me-in-production-generate-with-openssl-rand-hex-32

API_PORT=3001
WEB_ORIGIN=http://localhost:5173

# Where uploaded branding logos and metric workbooks are stored.
STORAGE_DIR=./storage
