{
  "name": "bgs-platform",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": { "node": ">=20" },
  "scripts": {
    "build": "pnpm -r build",
    "typecheck": "pnpm -r typecheck",
    "test": "pnpm -r test",
    "lint": "eslint .",
    "db:migrate": "pnpm --filter @bgs/db migrate",
    "db:reset": "pnpm --filter @bgs/db reset",
    "dev": "pnpm --parallel --filter @bgs/api --filter @bgs/web dev"
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "vitest": "^2.1.8"
  },
  "packageManager": "pnpm@9.15.0"
}
