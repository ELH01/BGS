{
  "name": "bgs-platform",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "pnpm -r build",
    "typecheck": "pnpm -r typecheck",
    "test": "pnpm -r test",
    "lint": "eslint .",
    "db:migrate": "pnpm --filter @bgs/db migrate",
    "db:reset": "pnpm --filter @bgs/db reset",
    "dev": "pnpm --parallel --filter @bgs/api --filter @bgs/web dev",
    "db:backup": "pnpm --filter @bgs/db exec tsx src/cli.ts backup",
    "db:restore": "pnpm --filter @bgs/db exec tsx src/cli.ts restore"
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "exceljs": "^4.4.0",
    "fflate": "^0.8.2",
    "playwright": "^1.62.1",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "vitest": "^2.1.8"
  },
  "packageManager": "pnpm@9.15.0"
}
